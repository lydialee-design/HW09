      "source": [
        "## 一、程式實作（測試一至測試三）\n",
        "\n",
        "### 測試一"
      ],
      "metadata": {
        "id": "qceptMbjm9GT"
      }
    },
    {
      "cell_type": "code",
      "metadata": {
        "id": "5191dbf8"
      },
      "source": [
        "# ==========================================\n",
        "# 測試一：原始資料輸入\n",
        "# ==========================================\n",
        "activity_names = (\"桌遊體驗\", \"電影欣賞\")\n",
        "board_raw = \" Amy, Ben, amy, Cora \"\n",
        "movie_raw = \" ben, Dora, ERIC, ben \"\n",
        "unit_fees = {\"桌遊體驗\": 120, \"電影欣賞\": 80}\n",
        "\n",
        "# 1. 讀取活動名稱\n",
        "board_title = activity_names[0]\n",
        "movie_title = activity_names[1]\n",
        "\n",
        "# 2. 清理字串並建立保留重複的串列 (轉小寫、移空白、依逗號拆分)\n",
        "board_list = board_raw.replace(\" \", \"\").lower().split(\",\")\n",
        "movie_list = movie_raw.replace(\" \", \"\").lower().split(\",\")\n",
        "\n",
        "# 3. 使用集合進行去重\n",
        "board_set = set(board_list)\n",
        "movie_set = set(movie_list)\n",
        "\n",
        "# 4. 集合運算比較名單\n",
        "common_participants = board_set & movie_set\n",
        "all_participants = board_set | movie_set\n",
        "only_board = board_set - movie_set\n",
        "only_movie = movie_set - board_set\n",
        "\n",
        "# 5. 排序名單並使用切片取得前兩位預覽\n",
        "sorted_all = sorted(list(all_participants))\n",
        "preview_notified = sorted_all[:2]\n",
        "\n",
        "# 6. 建立 summary 字典計算人數與應收費用\n",
        "summary = {\n",
        "    \"桌遊人數\": len(board_set),\n",
        "    \"電影人數\": len(movie_set),\n",
        "    \"共同人數\": len(common_participants),\n",
        "    \"總不重複人數\": len(all_participants),\n",
        "    \"報名人次\": len(board_set) + len(movie_set),\n",
        "    \"桌遊應收\": len(board_set) * unit_fees[board_title],\n",
        "    \"電影應收\": len(movie_set) * unit_fees[movie_title]\n",
        "}\n",
        "summary[\"總應收\"] = summary[\"桌遊應收\"] + summary[\"電影應收\"]\n",
        "\n",
        "# 7. 輸出完整摘要\n",
        "print(\"HW09 活動報名摘要 (測試一)\")\n",
        "print(f\"活動：{board_title}，每人 {unit_fees[board_title]:.2f} 元\")\n",
        "print(f\"活動：{movie_title}，每人 {unit_fees[movie_title]:.2f} 元\")\n",
        "print(f\"桌遊整理串列：{board_list}\")\n",
        "print(f\"電影整理串列：{movie_list}\")\n",
        "print(f\"桌遊去重名單：{sorted(list(board_set))}\")\n",
        "print(f\"電影去重名單：{sorted(list(movie_set))}\")\n",
        "print(f\"桌遊人數：{summary['桌遊人數']} 人\")\n",
        "print(f\"電影人數：{summary['電影人數']} 人\")\n",
        "print(f\"共同參加者：{sorted(list(common_participants))}\")\n",
        "print(f\"共同人數：{summary['共同人數']} 人\")\n",
        "print(f\"只參加桌遊者：{sorted(list(only_board))}\")\n",
        "print(f\"只參加電影者：{sorted(list(only_movie))}\")\n",
        "print(f\"全部參加者：{sorted_all}\")\n",
        "print(f\"總不重複人數：{summary['總不重複人數']} 人\")\n",
        "print(f\"報名人次：{summary['報名人次']} 人次\")\n",
        "print(f\"通知名單前兩位：{preview_notified}\")\n",
        "print(f\"桌遊應收：{summary['桌遊應收']:.2f} 元\")\n",
        "print(f\"電影應收：{summary['電影應收']:.2f} 元\")\n",
        "print(f\"總應收：{summary['總應收']:.2f} 元\")"
      ],
      "execution_count": null,
      "outputs": []
    },
